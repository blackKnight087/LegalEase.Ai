# Copy to .env for docker compose:  copy .env.docker.example .env

# --- Secrets (change in production) ---
POSTGRES_USER=legalease
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=legalease
JWT_SECRET=change_this_jwt_secret_min_32_chars
LEGALEASE_API_SECRET=change_this_api_secret_min_32_chars

# PostgreSQL — all app tables when SAAS_USE_POSTGRES_LEGACY=1 (Docker default)
DATABASE_URL=postgresql://legalease:change_this_strong_password@postgres:5432/legalease
SAAS_USE_POSTGRES_LEGACY=1
SAAS_AUTO_POSTGRES_LEGACY=1
SAAS_PRODUCTION=1

# Optional SQLite fallback path (unused when legacy Postgres is on)
LEGALEASE_DB_PATH=/data/legalease.db

# Redis — sessions + ML/e-discovery job queues
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SEC=86400
ML_USE_QUEUE=1

# Frontend must call API through nginx (/api prefix)
NEXT_PUBLIC_API_URL=https://your-domain.com/api
CORS_ORIGINS=https://your-domain.com
PUBLIC_APP_URL=https://your-domain.com

# LLM — LM Studio on host or Ollama sidecar
LLM_BACKEND=lmstudio
LM_STUDIO_URL=http://host.docker.internal:1234
LM_STUDIO_MODEL=meta-llama-3.1-8b-instruct
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Gemini (Open Law / Hybrid)
GEMINI_API_KEY=
GEMINI_DAILY_FREE=15
GEMINI_DAILY_PRO=200
GEMINI_DAILY_LEGAL_PRO=1000

# Email (console | smtp | sendgrid)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@your-domain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_LEGAL_PRO=

# Admin + monitoring
SUPERADMIN_USERNAMES=admin
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_DSN=

# Performance
RAG_ENABLE_CROSS_ENCODER=0
KB_PIPELINE_DEBUG=0
RATE_LIMIT_ENABLED=1
TAVILY_API_KEY=
