# =============================================================================
# LAPTOP vs EC2 (keep separate)
# - Laptop: API keys here + copy .env.local.example -> .env.local (run scripts\setup_local_env.ps1)
# - EC2: env only on server (/opt/legalease/.env) via deploy — never copy SAAS_PRODUCTION=1 into laptop .env.local
# =============================================================================
# Local LM Studio (same PC). Use http://OTHER_HOST:1234 if the server runs elsewhere.
# KB chat + drafting → Ollama legalease-tuned (recommended)
LLM_BACKEND=ollama
# Laptop/local: keep 0. AWS EC2 only: CLOUD_GEMINI_KB=1 (see deploy/aws/.env.production.example)
CLOUD_GEMINI_KB=0
LM_STUDIO_URL=http://127.0.0.1:1234
LM_STUDIO_MODEL=meta-llama-3.1-8b-instruct

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=legalease-tuned

# Task router — defaults to OLLAMA_MODEL (legalease-tuned) for every Ollama task
LLM_ROUTER_ENABLED=1
OLLAMA_MODEL_LEGAL=legalease-tuned
OLLAMA_MODEL_FAST=legalease-tuned
OLLAMA_MODEL_LEGAL_FALLBACK=legalease-tuned
# Optional Qwen (only if you explicitly set different FAST vs LEGAL models):
# OLLAMA_MODEL_FAST=qwen2.5:3b
# OLLAMA_MODEL_LEGAL=qwen3:8b
# OLLAMA_MODEL_LEGAL_FALLBACK=qwen2.5:7b
LLM_CLASSIFY_MAX_TOKENS=320
LLM_CLASSIFY_TIMEOUT_SEC=8
LLM_LEGAL_TIMEOUT_SEC=90
LLM_INTAKE_USE_RAG=1
LLM_INTAKE_RAG_K=3
LLM_INTAKE_FULL_ANALYSIS=1

# Public website intake → assign leads to firm user/org
INTAKE_PUBLIC_ENABLED=0
INTAKE_PUBLIC_KEY=
INTAKE_ORG_USER_ID=

# Web intelligence fallback chain (after Gemini quota/errors)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-2-9b-it:free
DEEPSEEK_API_KEY=
QWEN_API_KEY=
DASHSCOPE_API_KEY=

# ==============================================================================
# Google Gemini API — Open Law Web Intelligence (native Google Search Grounding)
# ==============================================================================
GEMINI_API_KEY=
GEMINI_FREE_MODEL=gemini-2.5-flash
WEB_INTELLIGENCE_DEBUG=0
STRICT_CITATIONS=0
LEGACY_WEB=0
JURISPRUDENCE_KB_K=14
GEMINI_DAILY_FREE=15
GEMINI_DAILY_PRO=200
GEMINI_DAILY_LEGAL_PRO=1000

# Settings-only: Gemini coaches Ollama via feedback analysis (never used in KB chat)
GEMINI_OLLAMA_TUNING=0
GEMINI_COACH_MODEL=gemini-2.5-flash
GEMINI_COACH_FEEDBACK_LIMIT=25

# Scheduled auto-coaching (daily when new feedback exists)
COACH_AUTO_SCHEDULE=1
COACH_AUTO_INTERVAL_DAYS=1
COACH_AUTO_MIN_NEW_FEEDBACK=1
COACH_AUTO_CHECK_INTERVAL_SEC=1800
COACH_AUTO_EXPORT_MODELFILE=1
COACH_AUTO_ENABLE_ON_FEEDBACK=1

# Full improvement automation — feedback → neural train → KB re-index → ollama create
IMPROVEMENT_AUTO=1
OLLAMA_AUTO_REINDEX=1
OLLAMA_AUTO_CREATE=1
OLLAMA_AUTO_USE_TUNED=1
OLLAMA_AUTO_EXPORT_MIN_THUMBS=20
OLLAMA_TUNED_MODEL_NAME=legalease-tuned
OLLAMA_CREATE_TIMEOUT_SEC=900

# KB: Gemini NEVER answers or modifies retrieval (Ollama + indexed PDFs only)
GEMINI_KB_SYNTHESIS=0
GEMINI_KB_RETRIEVAL_HINTS=0
GEMINI_KB_RERANK=0
KB_BLOCK_RUNTIME_COACH=1
KB_BLOCK_LEARNING_INJECT=1

# Gemini is allowed ONLY for Settings feedback/tuning (thumbs, coach, neural export)
# Open Law / Hybrid web leg may use Gemini; KB leg does not.
TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search
# When Gemini quota is exhausted, Web Intel falls back to Tavily → Serp → Google CSE → DuckDuckGo.
# Install: pip install duckduckgo-search
LEGAL_ONLY_WEB=1

# Practice SaaS — public intake form (website → CRM)
# INTAKE_PUBLIC_ENABLED=1
# INTAKE_PUBLIC_KEY=change-me-for-production
# Open web search by default (no include_domains). Set TAVILY_RESTRICT_DOMAINS=1 to limit MCP to legal sites:
# TAVILY_RESTRICT_DOMAINS=0
# TAVILY_LEGAL_DOMAINS=indiankanoon.org,main.sci.gov.in,scconline.com
# Web Intelligence speed (defaults tuned for fast local dev)
WEB_INTEL_FAST=1
WEB_INTEL_USE_LLM=0
WEB_SKIP_TAVILY_MCP=1
WEB_PREFER_TAVILY_REST=1
WEB_SEARCH_MAX_RESULTS=6
TAVILY_REST_TIMEOUT=12
TAVILY_MCP_TIMEOUT=8
WEB_LLM_MAX_TOKENS_FAST=900
WEB_LLM_MAX_TOKENS_CASE=1100

# OCR (EasyOCR)
OCR_ENABLED=1
OCR_LANGUAGES=en
OCR_GPU=0

# Google Custom Search JSON API (optional — legacy; new Google CSE signups often blocked)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# SerpAPI — Google results fallback when Tavily fails (https://serpapi.com)
SERP_API_KEY=
SERP_TIMEOUT=10
SERP_ENGINE=google

# RAG/Uploads
# Embeddings for RAG (never use LLM for vectors)
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_EMBEDDING_FALLBACK=BAAI/bge-base-en-v1.5
# 1 = fast MiniLM at startup/KB (recommended). 0 = load fine-tuned weights (slower).
RAG_PREFER_BASE_EMBEDDINGS=1
# 0 = SentenceTransformer only (recommended on Windows; avoids WinError 1455 from langchain_huggingface). 1 = try langchain_huggingface.
RAG_USE_LANGCHAIN_HF=0
RAG_SCORE_THRESHOLD=1.6
RAG_CONFIDENCE_THRESHOLD=0.52
# 0 = fast heuristic reranking (recommended on CPU). 1 = cross-encoder (slower, slightly more accurate).
RAG_ENABLE_CROSS_ENCODER=0
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANK_POOL_SIZE=12
MAX_UPLOAD_MB=200
# Large PDFs: 0 = no page cap; sparse OCR only on low-text pages (fast)
PDF_MAX_PAGES=0
OCR_MAX_PAGES=0
OCR_SPARSE_ONLY=1
OCR_WORKERS=4
OCR_MIN_CHARS_PER_PAGE=120
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_MAX_CHUNK=1400
# Chunks embedded per batch during index build (64 = faster; lower if RAM is tight)
RAG_INDEX_EMBED_BATCH=128
RAG_FAST_INDEX=1
INDEX_JOB_WORKERS=1
INDEX_JOB_USE_PROCESS=1
RAG_MAX_QUERY_EXPANSIONS=5
RAG_TOP_K_KEYWORD=24
FAISS_VS_CACHE_MAX=8
OLLAMA_KB_LOCK_MODEL=1
PDF_UPLOAD_TIMEOUT_SEC=900

# KB pipeline
KB_PIPELINE_DEBUG=1
KB_CACHE_TTL_SEC=300
KB_CACHE_MAX_ENTRIES=256

# API rate limiting
RATE_LIMIT_ENABLED=1
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_CHAT_PER_MINUTE=40
# Messaging exempt by default — Firm Chat, voice notes, AI assistant (no 429)
RATE_LIMIT_CHAT_EXEMPT=1
RATE_LIMIT_COLLAB_EXEMPT=1

# ==============================================================================
# Security (SaaS) — see SECURITY.md
# ==============================================================================
SECURITY_HEADERS_ENABLED=1
FORCE_HTTPS=1
HSTS_MAX_AGE=31536000
# Fernet key for optional field encryption at rest:
# py -c "from backend.app.core.crypto_vault import generate_encryption_key; print(generate_encryption_key())"
DATA_ENCRYPTION_KEY=
# Application-layer IP allowlist (comma-separated). Off by default.
# If FIREWALL_ENABLED=1 in production, FIREWALL_ALLOWED_IPS must be non-empty.
FIREWALL_ENABLED=0
FIREWALL_ALLOWED_IPS=
FIREWALL_TRUST_PROXY=1
# Production: disable localhost CORS regex (strict HTTPS origins only)
CORS_ALLOW_LOCALHOST_REGEX=0
PASSWORD_MIN_LENGTH=12
# Optional strict CSP for API responses (usually set at nginx for the web app)
# CONTENT_SECURITY_POLICY=default-src 'self'

# Retrieval depth (defaults in code: comparison k=10, summary k=12)
RAG_RETRIEVAL_K=8
RAG_FINAL_TOP_K=10
RAG_TOP_K_DENSE=16
RAG_MMR_LAMBDA=0.7

# ==============================================================================
# Day 4 — Postgres core (auth, chat, memory, learning) — see docs/DAY4_POSTGRES.md
# ==============================================================================
# DATABASE_URL=postgresql://legalease:changeme@localhost:5432/legalease
# SAAS_USE_POSTGRES_LEGACY=1
# py scripts/migrate_core_to_postgres.py   # one-time SQLite → Postgres copy
# alembic upgrade head                   # optional; same DDL as startup ensure_pg_core_schema
LEGALEASE_DB_PATH=
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL_SEC=86400
JWT_SECRET=change-me-in-production

# Client portal / e-sign / public app URL for mock sign links
PUBLIC_APP_URL=http://localhost:3000
ESIGN_PROVIDER=mock
# DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_ACCESS_TOKEN=

# In-app LLM LoRA SFT/DPO + inference-time RLHF/RLAIF
LLM_FINETUNE_ENABLED=1
LLM_FINETUNE_AUTO=1
LLM_FINETUNE_BASE_MODEL=google/gemma-2-2b-it
LLM_FINETUNE_MIN_SFT=5
LLM_FINETUNE_MIN_DPO=2
LLM_USE_TRAINED_ADAPTER=1
INFERENCE_REWARD_ENABLED=1
INFERENCE_REWARD_RERANK=1
CHAT_COACH_RUNTIME=1
CHAT_COACH_POSITIVE_EVERY=3

# GPU profile for 6GB VRAM laptops (RTX 4050): balanced | max_stt | max_chat — see docs/GPU_SETUP.md
GPU_PROFILE=balanced
# Install CUDA PyTorch: py -m pip install torch --index-url https://download.pytorch.org/whl/cu124
# Ollama GPU: set OLLAMA_NUM_GPU=999 before `ollama serve`

# Speech-to-text (faster-whisper; lazy-loaded on first mic press — requires ffmpeg on PATH)
STT_ENABLED=1
STT_ENGINE=faster_whisper
STT_MODEL=small
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_PRELOAD=0
STT_MAX_SECONDS=90
STT_MAX_UPLOAD_MB=12
STT_FALLBACK_BROWSER=1
STT_POLISH_DEFAULT=0

# KB strict grounding (Ollama paraphrase only — documents are source of truth)
KB_LLM_TEMPERATURE=0.23
RAG_MIN_ACCEPT_SCORE=0.50
KB_INDEX_MIN_VECTORS_WARN=20
KB_LLM_TOP_P=0.1

# ==============================================================================
# P0 SaaS production
# ==============================================================================
SAAS_PRODUCTION=0
# Set SAAS_PRODUCTION=1 on public deploy — enforces Stripe, blocks mock billing, validates secrets
SAAS_PRODUCTION_STRICT=1
ALLOW_MOCK_BILLING=1
# With DATABASE_URL=postgresql://..., auto-read auth/chat from Postgres in production:
SAAS_AUTO_POSTGRES_LEGACY=1
SAAS_USE_POSTGRES_LEGACY=0
# ML jobs off API thread (requires Redis + py scripts/ml_worker.py or docker ml-worker):
ML_USE_QUEUE=1
REDIS_URL=redis://127.0.0.1:6379/0
PLAN_DOC_LIMIT_FREE=2
PLAN_DOC_LIMIT_PRO=500
PLAN_DOC_LIMIT_LEGAL_PRO=5000
JWT_SECRET=change_this_jwt_secret_min_32_chars
LEGALEASE_API_SECRET=
REDIS_URL=redis://127.0.0.1:6379/0
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# After migrate_sqlite_to_pg.py, all app tables use Postgres:
# SAAS_USE_POSTGRES_LEGACY=1

# Sentry (optional — Day 9)
# SENTRY_DSN=https://xxx@o123.ingest.sentry.io/123
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Stripe (subscription payments — /settings/subscription)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_LEGAL_PRO=
STRIPE_PRICE_PRO_INR=999
STRIPE_PRICE_LEGAL_PRO_INR=4999
STRIPE_SUCCESS_PATH=/settings/subscription?checkout=success
STRIPE_CANCEL_PATH=/settings/subscription?checkout=cancel
# Webhook URL (Stripe Dashboard): POST https://YOUR_DOMAIN/api/v1/billing/stripe/webhook

# Matter / org hardening
MATTER_STRICT_SCOPE_ENFORCEMENT=1
MATTER_STRICT_ROLE_WRITE=1
LEARNING_SCOPE_PROMOTION_ENABLED=0
ORG_SEATS_FREE=1
ORG_SEATS_PRO=3
ORG_SEATS_LEGAL_PRO=10

# ==============================================================================
# P2 — Email, GDPR, observability
# ==============================================================================
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=LegalEase
# Brevo (recommended): verify sender at https://app.brevo.com
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# SMTP (Brevo relay): SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_USER=<brevo-login-email> SMTP_PASSWORD=<brevo-smtp-key>
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=
# SENDGRID_API_KEY=
# OBSERVABILITY_WEBHOOK_URL=https://hooks.example.com/legalease-events
# POSTHOG_API_KEY=phc_...          # Server-side product events (optional)
# POSTHOG_HOST=https://us.i.posthog.com

# Phase 6 — Enterprise SSO (optional)
# SSO_ENABLED=0
# SSO_DEV_MOCK=0
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://your-app.example.com/api/v1/sso/callback
# SAML_IDP_METADATA_URL=

# Phase 6 — eCourts live API (partnership required)
# ECOURTS_API_ENABLED=0
# ECOURTS_API_BASE=https://hcservices.ecourts.gov.in
# eCourtsIndia partner API (optional — users can also save key in Court Sync UI)
# ECOURTSINDIA_API_KEY=eci_live_your_token_here
# ECOURTSINDIA_API_BASE=https://webapi.ecourtsindia.com

# ==============================================================================
# P1 — Admin, ML worker, backups
# ==============================================================================
SUPERADMIN_USERNAMES=admin
# Run ML jobs off API thread: docker compose up ml-worker (needs REDIS_URL)

# ==============================================================================
# ZERO_BUDGET_DEMO — laptop + Ollama + Cloudflare Tunnel (see docs/DEPLOY_ZERO_BUDGET.md)
# ==============================================================================
# LLM_BACKEND=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=legalease-tuned
# After cloudflared gives you a URL, run:
#   .\scripts\configure_tunnel_env.ps1 -TunnelUrl "https://xxxx.trycloudflare.com"
# STABLE (no paid domain): .\scripts\setup_stable_cloudflare_tunnel.ps1
#   → https://yourname.mooo.com  (see docs/STABLE_PUBLIC_LINK.md)
# PUBLIC_APP_URL=https://your-stable-host.example.com
# CORS_ORIGINS=https://your-stable-host.example.com
# NEXT_PUBLIC_TUNNEL_HOST=your-stable-host.example.com
# web/.env.local should keep: NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# (Next.js proxies /api to backend — single tunnel on port 3000 is enough)
