# =============================================================================
# LAPTOP ONLY — copy to .env.local (gitignored). Never deployed to EC2.
# =============================================================================
# API keys (Gemini, Tavily, etc.) stay in .env
# This file restores full laptop behavior when .env has EC2 settings mixed in.
#
#   .\scripts\setup_local_env.ps1
#   .\run_backend.ps1
#   .\run_web.ps1
# =============================================================================

LEGALEEASE_LOCAL_DEV=1
SAAS_PRODUCTION=0
SAAS_PRODUCTION_STRICT=0
SAAS_USE_POSTGRES_LEGACY=0
SAAS_ALL_FEATURES_FREE=1
SAAS_ALLOW_FREE_HYBRID=1
ALLOW_MOCK_BILLING=1

DATABASE_URL=

LLM_BACKEND=ollama
CLOUD_GEMINI_KB=0
OLLAMA_AUTO_START=1

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_LOCALHOST_REGEX=1
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
