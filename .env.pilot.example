# Pilot template — copy to .env and fill secrets before: docker compose up -d --build

POSTGRES_USER=legalease
POSTGRES_PASSWORD=replace_with_strong_password_32chars
POSTGRES_DB=legalease

JWT_SECRET=replace_with_random_jwt_secret_min_32_characters
LEGALEASE_API_SECRET=replace_with_random_api_secret_min_32_chars

DATABASE_URL=postgresql://legalease:replace_with_strong_password_32chars@postgres:5432/legalease
SAAS_USE_POSTGRES_LEGACY=1
SAAS_AUTO_POSTGRES_LEGACY=1
SAAS_PRODUCTION=1
SAAS_PRODUCTION_STRICT=0
ALLOW_MOCK_BILLING=0

REDIS_URL=redis://redis:6379/0
ML_USE_QUEUE=1
SESSION_TTL_SEC=86400

LEGALEASE_DB_PATH=/data/legalease.db
PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Stripe TEST mode keys only for pilot
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_PRO=price_
STRIPE_PRICE_LEGAL_PRO=price_

SUPERADMIN_USERNAMES=admin
EMAIL_PROVIDER=console
SENTRY_DSN=

LLM_BACKEND=lmstudio
LM_STUDIO_URL=http://host.docker.internal:1234
RAG_ENABLE_CROSS_ENCODER=0
