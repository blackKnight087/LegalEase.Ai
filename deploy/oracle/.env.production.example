# Copy to /opt/legalease/.env on Oracle VM — then edit secrets and URLs.

POSTGRES_USER=legalease
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
POSTGRES_DB=legalease
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
LEGALEASE_API_SECRET=CHANGE_ME_openssl_rand_hex_32

DATABASE_URL=postgresql://legalease:CHANGE_ME_openssl_rand_hex_32@postgres:5432/legalease
SAAS_USE_POSTGRES_LEGACY=1
SAAS_AUTO_POSTGRES_LEGACY=1
SAAS_PRODUCTION=1
LEGALEASE_DB_PATH=/data/legalease.db

REDIS_URL=redis://redis:6379/0
SESSION_TTL_SEC=86400
ML_USE_QUEUE=1

# Replace YOUR.PUBLIC.IP or legalease.duckdns.org — web image bakes NEXT_PUBLIC_API_URL at build
PUBLIC_APP_URL=http://YOUR.PUBLIC.IP
CORS_ORIGINS=http://YOUR.PUBLIC.IP
NEXT_PUBLIC_API_URL=http://YOUR.PUBLIC.IP/api

# Ollama on VM host (not in Docker)
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL_LEGAL=qwen2.5:7b
OLLAMA_MODEL_FAST=qwen2.5:3b
OLLAMA_MODEL_LEGAL_FALLBACK=qwen2.5:7b
LLM_ROUTER_ENABLED=1
LLM_INTAKE_LEGAL_ANALYSIS=0
LOW_RESOURCE_MODE=1
RAG_ENABLE_CROSS_ENCODER=0
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

GEMINI_API_KEY=
GEMINI_KB_SYNTHESIS=0
GEMINI_DAILY_FREE=15

EMAIL_PROVIDER=console
ALLOW_MOCK_BILLING=1
FORCE_HTTPS=0
SECURITY_HEADERS_ENABLED=1
FIREWALL_ENABLED=0
RATE_LIMIT_ENABLED=1

SUPERADMIN_USERNAMES=admin
SENTRY_DSN=
