# LegalEase — hardened production environment (copy to server as .env)
# Generate local secrets:  pwsh scripts/rotate_secrets.ps1
# Verify before go-live:     py scripts/verify_production_ready.py

# --- Core production flags ---
SAAS_PRODUCTION=1
SAAS_PRODUCTION_STRICT=1
SAAS_USE_POSTGRES_LEGACY=1
SAAS_AUTO_POSTGRES_LEGACY=1
ALLOW_MOCK_BILLING=0
FORCE_HTTPS=1
LOW_RESOURCE_MODE=0

# --- Secrets (run rotate_secrets script; never use placeholders) ---
JWT_SECRET=
LEGALEASE_API_SECRET=
DATA_ENCRYPTION_KEY=
POSTGRES_USER=legalease
POSTGRES_PASSWORD=
POSTGRES_DB=legalease
DATABASE_URL=postgresql://legalease:POSTGRES_PASSWORD@postgres:5432/legalease
INTERNAL_CRON_SECRET=

# --- Public URLs (HTTPS only) ---
PUBLIC_APP_URL=https://app.yourfirm.com
NEXT_PUBLIC_API_URL=https://app.yourfirm.com/api
CORS_ORIGINS=https://app.yourfirm.com
CORS_ALLOW_LOCALHOST_REGEX=0

# --- Infrastructure ---
REDIS_URL=redis://redis:6379/0
ML_USE_QUEUE=1
SESSION_TTL_SEC=86400

# --- Security / firewall ---
SECURITY_HEADERS_ENABLED=1
HSTS_MAX_AGE=31536000
RATE_LIMIT_ENABLED=1
RATE_LIMIT_CHAT_EXEMPT=0
PASSWORD_MIN_LENGTH=12
# Optional pilot/admin IP lockdown (requires non-empty allowlist when enabled)
FIREWALL_ENABLED=0
FIREWALL_ALLOWED_IPS=
FIREWALL_TRUST_PROXY=1

# --- Billing (live Stripe — rotate keys in Stripe Dashboard) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_LEGAL_PRO=

# --- Email (not console in production) ---
EMAIL_PROVIDER=brevo
BREVO_API_KEY=

# --- LLM (rotate in Google AI Studio) ---
LLM_BACKEND=gemini
GEMINI_API_KEY=

# --- Optional observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
